# Copy this file to .env and fill in real values.

# Required — get one at console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional — override the model Groq calls. Check console.groq.com/docs/models
# if you start seeing "model_not_found" errors; Groq's free-tier lineup
# changes every couple of months.
GROQ_MODEL=openai/gpt-oss-20b

# Optional — signs the session cookie that maps each browser to its own
# conversation thread. Set this to a long random string for anything beyond
# local testing (a fresh random one is generated automatically otherwise,
# but it changes on every restart, which logs everyone out of their thread).
FLASK_SECRET_KEY=change_me_to_something_random

# Optional — path to the SQLite database file.
TASKS_DB_PATH=my_tasks.db
